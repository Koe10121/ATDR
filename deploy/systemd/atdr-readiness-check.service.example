[Unit]
Description=ATDR read-only readiness check
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=atdr
Group=atdr
WorkingDirectory=/opt/atdr
EnvironmentFile=/etc/atdr/atdr.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/atdr/.venv/bin/python -m atdr.scripts.check_runtime_readiness
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
