# Copy to /etc/atdr/atdr.env with mode 0600 and replace every placeholder.
# Never commit the deployed file.
ENVIRONMENT=shared_lab
DATABASE_URL=postgresql+psycopg2://atdr:<password>@127.0.0.1:5432/atdr
AUTO_CREATE_TABLES=false
JWT_SECRET_KEY=<managed-secret>
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER=simulation
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
DEPLOYMENT_REHEARSAL_APPROVED=false
DEPLOYMENT_PUBLIC_BASE_URL=https://atdr.example.local
DEPLOYMENT_DNS_NAME=atdr.example.local
DEPLOYMENT_TLS_CERTIFICATE_PATH=/etc/atdr/tls/fullchain.pem
DEPLOYMENT_TLS_PRIVATE_KEY_PATH=/etc/atdr/tls/privkey.pem
DEPLOYMENT_PROMETHEUS_URL=http://127.0.0.1:9090
DEPLOYMENT_SECRET_PROVIDER=disabled
ATDR_BACKUP_DIRECTORY=/var/backups/atdr
ATDR_BACKUP_MAX_AGE_HOURS=30

OPERATION_WORKER_DEPLOYMENT_ID=shared-lab
OPERATION_WORKER_CONCURRENCY=2
OPERATION_WORKER_POLL_SECONDS=1
OPERATION_WORKER_LEASE_SECONDS=900
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_WORKER_SHUTDOWN_GRACE_SECONDS=120
OPERATION_STAGING_ROOT=/srv/atdr/shared/operation-jobs
OPERATION_STAGING_SHARED=true
OPERATION_STAGING_STORAGE_ID=shared-lab-staging-v1

MFU_IAM_ENABLED=false
ASSISTANT_ENABLED=false
ASSISTANT_LLM_ENABLED=false
ASSISTANT_ALLOW_RAW_LOG_CONTEXT=false
