[Unit]
Description=ATDR FastAPI service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=atdr
Group=atdr
WorkingDirectory=/opt/atdr
EnvironmentFile=/etc/atdr/atdr.env
ExecStart=/opt/atdr/.venv/bin/python -m uvicorn atdr.app.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atdr /srv/atdr/shared

[Install]
WantedBy=multi-user.target
