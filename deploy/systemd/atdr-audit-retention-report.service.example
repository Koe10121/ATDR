[Unit]
Description=ATDR audit-retention report only
After=postgresql.service

[Service]
Type=oneshot
User=atdr
Group=atdr
WorkingDirectory=/opt/atdr
EnvironmentFile=/etc/atdr/atdr.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/atdr/.venv/bin/python -m atdr.scripts.audit_retention --pretty
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
