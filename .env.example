APP_NAME="MFU ATDR"

# Local SQLite demo profile.
# Use this file for supervisor demos and development on one machine.
# For PostgreSQL lab-pilot deployment use `.env.lab.example`.
# For future hardened deployment use `.env.production.example`.
DATABASE_URL="sqlite:///./atdr.db"
# PostgreSQL pool settings are ignored by SQLite except the connection timeout.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000
AUTO_CREATE_TABLES=true
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER="simulation"
DEFAULT_IMPORT_LIMIT=5000
MIN_ALERT_SCORE=30
ML_MODEL_PATH="atdr/models/isolation_forest.joblib"
SUPERVISED_MODEL_PATH="atdr/models/supervised_classifier.joblib"
# v5.8 diagnostic candidate scoring is read-only and disabled by default.
# Enabling it never grants alert, suppression, response, or model authority.
GOVERNED_SHADOW_SCORING_ENABLED=false
GOVERNED_SHADOW_BATCH_SIZE=250
GOVERNED_SHADOW_MAX_BATCH_SIZE=1000
GOVERNED_SHADOW_TIMEOUT_SECONDS=30
GOVERNED_SHADOW_CACHE_SECONDS=30
# Aggregate longitudinal observation history is separately disabled by default.
# It never stores raw logs, IP addresses, labels, private paths, or model artifacts.
GOVERNED_SHADOW_OBSERVATION_ENABLED=false
GOVERNED_SHADOW_OBSERVATION_RETENTION_DAYS=90
GOVERNED_SHADOW_OBSERVATION_TREND_LIMIT=30
# Durable historical monitoring remains off unless an operator explicitly
# enables it and invokes the due-check CLI or an approved external timer.
GOVERNED_SHADOW_MONITORING_ENABLED=false
GOVERNED_SHADOW_MONITORING_CADENCE_MINUTES=60
GOVERNED_SHADOW_MONITORING_MAX_SOURCES=8
GOVERNED_SHADOW_MONITORING_MAX_WINDOWS_PER_SOURCE=3
GOVERNED_SHADOW_MONITORING_MIN_ROWS=50
GOVERNED_SHADOW_MONITORING_BATCH_LIMIT=250
ML_CONTAMINATION=0.03
API_BASE_URL="http://127.0.0.1:8000"
# React dashboard env lives in frontend/.env.example:
# VITE_API_BASE_URL=http://127.0.0.1:8000
JWT_SECRET_KEY="change-this-secret-before-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_ANALYST_USERNAME="analyst"
DEMO_ANALYST_PASSWORD="analyst123"
# Local demo scripts read this path only when requested.
# For real or large logs, keep the file outside Git, for example:
# DEMO_SAMPLE_LOG_PATH="D:/Private Logs/paloalto-firewall.log"
DEMO_SAMPLE_LOG_PATH="data/samples/paloalto-demo.txt"
DEMO_IMPORT_LIMIT=5000
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:5173,http://localhost:5173"
SECURITY_HEADERS_ENABLED=true
# Forwarded headers are ignored unless this is explicitly enabled and the
# direct peer belongs to one of these networks. Keep false for normal localhost.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"
# Controlled preproduction rehearsal. Keep unapproved and unconfigured for
# normal local use; real certificate/key paths and providers belong in .env.
DEPLOYMENT_REHEARSAL_APPROVED=false
DEPLOYMENT_PUBLIC_BASE_URL=""
DEPLOYMENT_DNS_NAME=""
DEPLOYMENT_TLS_CERTIFICATE_PATH=""
DEPLOYMENT_TLS_PRIVATE_KEY_PATH=""
DEPLOYMENT_PROMETHEUS_URL=""
DEPLOYMENT_SECRET_PROVIDER="disabled"
SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
SYSLOG_BATCH_SIZE=100
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Explicit local recovery/development profile. Normal team startup uses
# `.env.shell.example` and the mandatory MFU outer shell instead.
ATDR_AUTH_MODE="local_recovery"

# External school-email IAM groundwork. Disabled in this explicit recovery
# profile. Normal team use is configured from `.env.shell.example`; provider,
# client, allowed-domain, and role-mapping values require approved private
# configuration.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER_URL=""
OIDC_ALLOWED_DOMAINS=""
OIDC_DEFAULT_ROLE="analyst"

# MFU IAM / Google SSO adapter placeholders. Disabled by default.
# These are visibility/planning fields only until advisor-approved provider
# details, callback URLs, client credentials, and group-to-role mapping are
# provided. Do not commit real secrets.
MFU_IAM_ENABLED=false
MFU_IAM_BASE_URL=""
MFU_IAM_CLIENT_ID=""
MFU_IAM_CLIENT_SECRET=""
MFU_IAM_AUDIENCE=""
MFU_IAM_SCOPE=""
MFU_IAM_TIMEOUT_MS=5000
MFU_IAM_TOKEN_PATH="/api/v1/b2b/token"
MFU_IAM_INTROSPECT_PATH="/api/v1/b2b/introspect"
MFU_IAM_PROFILE_PATH="/api/v1/b2b/clients/me"
MFU_IAM_ADMIN_BASE_PATH="/api/v1/b2b/admin"
MFU_IAM_ADMIN_CLIENT_ID=""
MFU_IAM_ADMIN_CLIENT_SECRET=""
MFU_IAM_ADMIN_AUDIENCE=""
MFU_IAM_ADMIN_SCOPE=""
MFU_IAM_COMPAT_PROFILE=""
MFU_IAM_ALLOWED_DOMAINS=""
MFU_IAM_DEFAULT_ROLE="analyst"
MFU_IAM_MOCK_ENABLED=false
# Secure template-shell handoff. The supervisor template owns school sign-in
# and 2FA. ATDR receives only a short-lived one-time code in a POST form and
# exchanges it server-to-server. Never pass template access tokens in URLs.
# Keep disabled until both private services share a dedicated bridge secret.
# The bridge secret is not an IAM client secret and must never be committed.
MFU_IAM_TEMPLATE_SHELL_ENABLED=false
MFU_IAM_TEMPLATE_SHELL_BASE_URL=""
MFU_IAM_TEMPLATE_SHELL_ME_PATH="/api/v1/auth/me"
MFU_IAM_TEMPLATE_SHELL_HEADER="x-access-token"
MFU_IAM_HANDOFF_ENABLED=false
MFU_IAM_HANDOFF_EXCHANGE_PATH="/api/v1/atdr/handoff/exchange"
MFU_IAM_HANDOFF_SHARED_SECRET=""
MFU_IAM_HANDOFF_SECRET_HEADER="x-atdr-handoff-secret"
MFU_IAM_HANDOFF_FRONTEND_URL="http://127.0.0.1:5173"
MFU_IAM_HANDOFF_COOKIE_NAME="atdr_session"
MFU_IAM_HANDOFF_COOKIE_SECURE=false
MFU_IAM_HANDOFF_ALLOWED_ORIGINS=""
MFU_IAM_HANDOFF_ALLOWED_RETURN_PATHS="/overview,/alerts,/logs,/assistant,/response,/audit,/ml"
MFU_IAM_TEMPLATE_SHELL_LAUNCH_URL=""
# The legacy browser token endpoint remains disabled. Do not enable it for
# template-to-ATDR use; use the one-time server-side handoff instead.
# External users default to analyst. Only explicitly approved template groups
# may map to admin; email addresses alone do not grant template-handoff admin.
MFU_IAM_ADMIN_GROUPS=""
# Optional explicit admin mapping for externally authenticated school-email users.
# Leave empty unless an advisor-approved mapping says these accounts should be admin.
MFU_IAM_ADMIN_EMAILS=""
MFU_IAM_PERMISSION_SOURCE=""
MFU_IAM_PERMISSION_BOOTSTRAP_MODE=""
MFU_IAM_PERMISSION_ROOT_PATH=""
MFU_IAM_PERMISSION_PATHS=""
MFU_IAM_PROJECT_ACCOUNT_EMAIL=""
MFU_IAM_AUTH_REQUIRE_2FA=false
MFU_IAM_AUDIT_RETENTION_DAYS=90
MFU_IAM_MANAGED_CLIENT_ID=""
MFU_IAM_MANAGED_CLIENT_ENDPOINT=""
MFU_IAM_MANAGED_CLIENT_OWNER_EMAIL=""
MFU_IAM_MANAGED_CLIENT_ALLOWED_SCOPES=""
MFU_IAM_MANAGED_CLIENT_ALLOWED_AUDIENCES=""
MFU_IAM_INIT_ADMIN_EMAILS=""
MFU_IAM_INIT_SEED_ADMIN_EMAIL=""
# Compatibility note: ATDR also accepts the supervisor template names
# IAM_SDK_*, IAM_ADMIN_*, and PROJECT_PERMISSION_* from a local `.env`.
# Keep all real IAM secrets local only; never commit `.env`.
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=""

# Local school-email account policy. Keep optional for lab/demo unless the
# advisor approves a strict school-domain-only account policy.
SCHOOL_EMAIL_DOMAINS=""
REQUIRE_SCHOOL_EMAIL=false
LOCAL_EMAIL_LOGIN_ENABLED=true

# Email verification/notification foundation. Disabled by default and safe for
# local development. Use EMAIL_DELIVERY_MODE=dev_outbox only when you want an
# admin-visible local test outbox; no real email is sent unless a future SMTP
# delivery implementation is explicitly approved and configured.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
EMAIL_DELIVERY_MODE="disabled"
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_REQUIRED_FOR_LOGIN=false
EMAIL_VERIFICATION_REQUIRED_FOR_ADMIN_ACTIONS=false

# Short-lived dashboard summary cache for large local SQLite DBs.
DASHBOARD_SUMMARY_CACHE_SECONDS=30

# Operational history maintenance. These values are advisory until an operator
# explicitly runs the maintenance command with --execute.
JOB_STALE_AFTER_MINUTES=60
JOB_RETENTION_DAYS=30
RUN_HISTORY_RETENTION_DAYS=90

# Durable operation worker. The API never starts a worker automatically.
# Keep false for normal local use. Use --once for an explicit single job, or
# set true only before starting a deliberate shared-lab --watch worker.
OPERATION_WORKER_ENABLED=false
OPERATION_WORKER_POLL_SECONDS=1
OPERATION_WORKER_LEASE_SECONDS=900
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_WORKER_DEPLOYMENT_ID=local
OPERATION_WORKER_CONCURRENCY=1
OPERATION_WORKER_SHUTDOWN_GRACE_SECONDS=120
OPERATION_JOB_DEFAULT_MAX_ATTEMPTS=1
OPERATION_JOB_MAX_ATTEMPTS=3
OPERATION_JOB_RETRY_DELAY_SECONDS=60
OPERATION_JOB_MAX_INPUT_BYTES=52428800
INGESTION_CHUNK_SIZE=500
INGESTION_PROGRESS_UPDATE_INTERVAL=500
OPERATION_MAX_QUEUED_IMPORTS=10
OPERATION_MAX_QUEUED_JOBS_PER_ACTOR=5
OPERATION_STAGING_MAX_TOTAL_BYTES=1073741824
OPERATION_STAGING_MIN_FREE_BYTES=268435456
OPERATION_STAGING_RETENTION_HOURS=24
# Blank keeps ignored local storage at .atdr_runtime/operation-jobs.
OPERATION_STAGING_ROOT=""
OPERATION_STAGING_SHARED=false
OPERATION_STAGING_STORAGE_ID=local

# Disposable v5.17 PostgreSQL acceptance targets only. Leave blank for normal
# SQLite use. Both databases must be empty, separately named with v517/test/ci,
# and must never point to DATABASE_URL.
ATDR_V517_POSTGRES_DATABASE_URL=
ATDR_V517_RESTORE_DATABASE_URL=
OPERATION_QUEUE_BACKLOG_WARNING=25
OPERATION_JOB_FAILURE_WARNING_COUNT=3
OPERATION_JOB_FAILURE_WARNING_WINDOW_MINUTES=60
# Optional protected backup freshness monitoring. No backup is created by metrics.
ATDR_BACKUP_DIRECTORY=""
ATDR_BACKUP_MAX_AGE_HOURS=30
# Audit retention is report-only unless the CLI receives both --apply and its confirmation phrase.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_MIN_DAYS=90
AUDIT_RETENTION_BATCH_SIZE=500

# SOC analyst assistant. External LLM use is disabled by default; the local
# deterministic helper can still answer safe read-only ATDR workflow questions.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER="disabled"
ASSISTANT_MODEL=""
ASSISTANT_API_KEY=""
# Future real LLM adapter placeholders. Keep disabled until a provider, data
# sharing policy, key storage, and audit review are approved. Recommended order:
# Gemini for MFU/Google availability, then OpenAI-compatible, then Claude.
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=""
ASSISTANT_LLM_MODEL=""
ASSISTANT_LLM_API_KEY=""
ASSISTANT_LLM_BASE_URL=""
ASSISTANT_LLM_TIMEOUT_SECONDS=15
ASSISTANT_LLM_MAX_RETRIES=2
ASSISTANT_LLM_MAX_PROMPT_CHARS=12000
ASSISTANT_CONVERSATION_HISTORY_TURNS=4
ASSISTANT_RATE_LIMIT_REQUESTS=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
ASSISTANT_MAX_CONTEXT_ROWS=20
ASSISTANT_REDACT_IPS=true
ASSISTANT_ALLOW_RAW_LOG_CONTEXT=false

# Warning:
# - Demo credentials and demo JWT secret are unsafe for shared lab or production use.
# - Keep RESPONSE_SIMULATION=true unless a future firewall connector is formally approved.
# - Keep real firewall logs in data/private/, real_logs/, or outside this repository.
# - MongoDB is not required for local ATDR development.
