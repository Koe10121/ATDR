APP_NAME="MFU ATDR"

# Local SQLite demo profile.
# Use this file for supervisor demos and development on one machine.
# For PostgreSQL lab-pilot deployment use `.env.lab.example`.
# For future hardened deployment use `.env.production.example`.
DATABASE_URL="sqlite:///./atdr.db"
AUTO_CREATE_TABLES=true
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER="simulation"
DEFAULT_IMPORT_LIMIT=5000
MIN_ALERT_SCORE=30
ML_MODEL_PATH="atdr/models/isolation_forest.joblib"
SUPERVISED_MODEL_PATH="atdr/models/supervised_classifier.joblib"
ML_CONTAMINATION=0.03
API_BASE_URL="http://127.0.0.1:8000"
JWT_SECRET_KEY="change-this-secret-before-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_ANALYST_USERNAME="analyst"
DEMO_ANALYST_PASSWORD="analyst123"
DEMO_SAMPLE_LOG_PATH="paloalto-firewall(1).log"
DEMO_IMPORT_LIMIT=5000
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:5173,http://localhost:5173"
SECURITY_HEADERS_ENABLED=true
SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
SYSLOG_BATCH_SIZE=100
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Warning:
# - Demo credentials and demo JWT secret are unsafe for shared lab or production use.
# - Keep RESPONSE_SIMULATION=true unless a future firewall connector is formally approved.
