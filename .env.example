APP_NAME="MFU ATDR"
DATABASE_URL="sqlite:///./atdr.db"
AUTO_CREATE_TABLES=true
RESPONSE_SIMULATION=true
DEFAULT_IMPORT_LIMIT=5000
MIN_ALERT_SCORE=30
ML_MODEL_PATH="atdr/models/isolation_forest.joblib"
ML_CONTAMINATION=0.03
API_BASE_URL="http://127.0.0.1:8000"
JWT_SECRET_KEY="change-this-secret-before-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_ANALYST_USERNAME="analyst"
DEMO_ANALYST_PASSWORD="analyst123"
DEMO_SAMPLE_LOG_PATH="paloalto-firewall(1).log"
DEMO_IMPORT_LIMIT=5000
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8501,http://localhost:8501"
SECURITY_HEADERS_ENABLED=true
SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
SYSLOG_BATCH_SIZE=100
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Production lab guidance:
# - Set ENVIRONMENT="production"
# - Set AUTO_CREATE_TABLES=false and run `alembic upgrade head`
# - Use PostgreSQL, for example:
#   DATABASE_URL="postgresql+psycopg2://atdr:change-me@postgres:5432/atdr"
# - Replace JWT_SECRET_KEY with a long random secret.
# - Set CORS_ALLOWED_ORIGINS to the exact dashboard origin; do not use "*".
# - Keep RESPONSE_SIMULATION=true until firewall enforcement is formally approved.
