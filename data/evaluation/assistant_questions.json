{
  "version": "atdr_assistant_scoreboard_v2",
  "description": "Realistic analyst and reviewer questions for the SOC assistant, scored automatically. 'facts' are computed from the database independently of the assistant; '{placeholders}' are filled from the database at run time. A question passes only if every listed check passes. v2 (2026-09-26) only tightened checks after reading real answers: alert IDs no longer count as numbers, how-to and concept answers must name ATDR's real pages and values, rankings must name the real top item, and no answer may show internal tool names. open-11 and rank-08 came from the held-out set after they were used to fix a problem. 2026-09-27: the assistant now also answers general questions from its own knowledge (labelled as such), so the out-of-scope checks expect a real reply or an honest 'no internet access' instead of a refusal, and gen-* was added. Later on 2026-09-27, ti-01, ti-02 and mfu-01 were added when the assistant gained the watchlist and MFU behaviour-model tools; before that it answered mfu-01 with the earlier anomaly model's status.",
  "checks": {
    "answered": "the assistant did not fall back to 'I don't have a specific built-in answer'",
    "facts": "each named fact's value appears in the answer (thousands separators ignored)",
    "any": "at least one of these phrases appears (case-insensitive)",
    "all": "every one of these phrases appears (case-insensitive)",
    "none": "none of these phrases appears (case-insensitive)",
    "mentions_facts": "each named fact's value appears as text in the answer (case-insensitive)",
    "never": "suite-wide: no answer may contain these phrases"
  },
  "never": ["security_overview", "query_alerts", "query_logs", "get_alert", "get_alert_playbook", "get_log", "explain_detection_rules", "explain_concept", "dashboard_how_to", "system_status"],
