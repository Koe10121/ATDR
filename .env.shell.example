# Portable ATDR profile for the mandatory MFU outer shell.
# Copy through scripts/setup_team.ps1. Never place real secrets in this file.
APP_NAME="MFU ATDR"
ENVIRONMENT="development"
ATDR_AUTH_MODE="template_shell"

DATABASE_URL="sqlite:///./atdr.db"
AUTO_CREATE_TABLES=true
DB_CONNECT_TIMEOUT_SECONDS=10
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER="simulation"
API_BASE_URL="http://127.0.0.1:8000"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
JWT_SECRET_KEY="replace-during-private-setup"
MFU_SHELL_LOCAL_KEY="replace-during-private-setup"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

MFU_IAM_ENABLED=true
MFU_IAM_TEMPLATE_SHELL_ENABLED=true
MFU_IAM_TEMPLATE_SHELL_BASE_URL="http://127.0.0.1:8214"
MFU_IAM_TEMPLATE_SHELL_LAUNCH_URL="http://localhost:8080/#/pages/login"
MFU_IAM_ALLOWED_DOMAINS="lamduan.mfu.ac.th"
MFU_IAM_DEFAULT_ROLE="analyst"
MFU_IAM_ADMIN_GROUPS=""
MFU_IAM_HANDOFF_ENABLED=true
MFU_IAM_HANDOFF_EXCHANGE_PATH="/api/v1/atdr/handoff/exchange"
MFU_IAM_HANDOFF_SHARED_SECRET="replace-during-private-setup"
MFU_IAM_HANDOFF_SECRET_HEADER="x-atdr-handoff-secret"
MFU_IAM_HANDOFF_FRONTEND_URL="http://127.0.0.1:5173"
MFU_IAM_HANDOFF_COOKIE_NAME="atdr_session"
MFU_IAM_HANDOFF_COOKIE_SECURE=false
MFU_IAM_HANDOFF_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
MFU_IAM_HANDOFF_ALLOWED_RETURN_PATHS="/overview,/alerts,/logs,/assistant,/response,/audit,/ml"

# Shell-owned Google configuration is intentionally not copied into ATDR.
# The approved external shell must privately configure the same client ID as:
#   frontend-vue/.env.localdev -> VUE_APP_CLIENTID
#   backend-node/.env.local    -> GOOGLE_CLIENT_ID
# The approved local browser origin is exactly http://localhost:8080.

# The assistant remains read-only. Real provider values belong only in .env.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER="disabled"
ASSISTANT_API_KEY=""
ASSISTANT_ALLOW_RAW_LOG_CONTEXT=false
ASSISTANT_REDACT_IPS=true
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=""
ASSISTANT_LLM_MODEL=""
ASSISTANT_LLM_API_KEY=""

SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
