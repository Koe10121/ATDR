# ATDR controlled preproduction profile. Copy values into an approved private
# secret/configuration source; do not rename this file to a tracked real env.
ENVIRONMENT=preproduction
DATABASE_URL=postgresql+psycopg2://atdr:<managed-password>@127.0.0.1:5432/atdr
AUTO_CREATE_TABLES=false
JWT_SECRET_KEY=<managed-random-secret-at-least-32-characters>
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER=simulation

# Set true only during the approved v3.96 rehearsal window.
DEPLOYMENT_REHEARSAL_APPROVED=false
DEPLOYMENT_PUBLIC_BASE_URL=https://atdr.example.local
DEPLOYMENT_DNS_NAME=atdr.example.local
DEPLOYMENT_TLS_CERTIFICATE_PATH=/etc/atdr/tls/fullchain.pem
DEPLOYMENT_TLS_PRIVATE_KEY_PATH=/etc/atdr/tls/privkey.pem
DEPLOYMENT_PROMETHEUS_URL=http://127.0.0.1:9090
DEPLOYMENT_SECRET_PROVIDER=disabled

CORS_ALLOWED_ORIGINS=https://atdr.example.local
SECURITY_HEADERS_ENABLED=true
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000

OPERATION_WORKER_ENABLED=true
OPERATION_WORKER_DEPLOYMENT_ID=preproduction-a
OPERATION_WORKER_CONCURRENCY=2
OPERATION_WORKER_POLL_SECONDS=1
OPERATION_WORKER_LEASE_SECONDS=900
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_WORKER_SHUTDOWN_GRACE_SECONDS=120
OPERATION_STAGING_ROOT=/srv/atdr/shared/operation-jobs
OPERATION_STAGING_SHARED=true
OPERATION_STAGING_STORAGE_ID=<approved-shared-storage-id>
OPERATION_STAGING_MIN_FREE_BYTES=268435456

ATDR_BACKUP_DIRECTORY=/var/backups/atdr
ATDR_BACKUP_MAX_AGE_HOURS=30

# MFU one-time-code handoff. Keep disabled until both services have the same
# privately managed bridge secret and approved exact origins.
MFU_IAM_ENABLED=false
MFU_IAM_TEMPLATE_SHELL_ENABLED=false
MFU_IAM_TEMPLATE_SHELL_BASE_URL=
MFU_IAM_HANDOFF_ENABLED=false
MFU_IAM_HANDOFF_SHARED_SECRET=
MFU_IAM_HANDOFF_FRONTEND_URL=https://atdr.example.local
MFU_IAM_HANDOFF_ALLOWED_ORIGINS=
MFU_IAM_HANDOFF_COOKIE_SECURE=true
MFU_IAM_ALLOWED_DOMAINS=lamduan.mfu.ac.th
MFU_IAM_DEFAULT_ROLE=analyst

# External assistant remains optional and read-only. Raw evidence is disabled.
ASSISTANT_ENABLED=false
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_ALLOW_RAW_LOG_CONTEXT=false
ASSISTANT_REDACT_IPS=true

OIDC_ENABLED=false
GOOGLE_SSO_ENABLED=false
SMTP_ENABLED=false
EMAIL_DELIVERY_MODE=disabled
