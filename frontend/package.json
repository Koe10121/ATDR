  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:api": "node ../scripts/start_backend_for_dashboard.cjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
