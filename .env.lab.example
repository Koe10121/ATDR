APP_NAME="MFU ATDR"

# PostgreSQL lab-pilot profile.
# Copy this to `.env` only on a Docker/PostgreSQL lab host.
# The hostname `postgres` is a Docker Compose service alias. It will not work
# from a normal Windows terminal unless the PostgreSQL/Docker lab stack is up.
ENVIRONMENT="production"
DATABASE_URL="postgresql+psycopg2://atdr:replace-with-strong-password@postgres:5432/atdr"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000
AUTO_CREATE_TABLES=false
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER="simulation"

DEFAULT_IMPORT_LIMIT=5000
MIN_ALERT_SCORE=30
ML_MODEL_PATH="atdr/models/isolation_forest.joblib"
SUPERVISED_MODEL_PATH="atdr/models/supervised_classifier.joblib"
ML_CONTAMINATION=0.03
API_BASE_URL="http://127.0.0.1:8000"
# React dashboard env lives in frontend/.env.example:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Replace before any shared lab use. Generate a long random value.
JWT_SECRET_KEY="replace-with-long-random-lab-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Replace demo passwords before shared lab use.
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="replace-this-lab-admin-password"
DEMO_ANALYST_USERNAME="analyst"
DEMO_ANALYST_PASSWORD="replace-this-lab-analyst-password"
# Keep the lab profile safe by default. Point this to an approved private log
# outside Git only on the target lab machine.
DEMO_SAMPLE_LOG_PATH="data/samples/paloalto-demo.txt"
DEMO_IMPORT_LIMIT=5000

LOG_LEVEL="INFO"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:5173,http://localhost:5173"
SECURITY_HEADERS_ENABLED=true
# Enable only when the API is bound behind the approved loopback reverse proxy.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"

# Bind syslog to localhost until the lab firewall/network scope is approved.
SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
SYSLOG_BATCH_SIZE=100

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Optional school-email IAM groundwork. Disabled until provider details are
# approved and callback/login implementation is completed.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER_URL=""
OIDC_ALLOWED_DOMAINS=""
OIDC_DEFAULT_ROLE="analyst"

# MFU IAM / Google SSO adapter placeholders. Disabled until the school/provider
# details are approved and the future callback/login implementation is reviewed.
# Keep real client secrets outside Git.
MFU_IAM_ENABLED=false
MFU_IAM_BASE_URL=""
MFU_IAM_CLIENT_ID=""
MFU_IAM_CLIENT_SECRET=""
MFU_IAM_AUDIENCE=""
MFU_IAM_SCOPE=""
MFU_IAM_TIMEOUT_MS=5000
MFU_IAM_TOKEN_PATH="/api/v1/b2b/token"
MFU_IAM_INTROSPECT_PATH="/api/v1/b2b/introspect"
MFU_IAM_PROFILE_PATH="/api/v1/b2b/clients/me"
MFU_IAM_ADMIN_BASE_PATH="/api/v1/b2b/admin"
MFU_IAM_ADMIN_CLIENT_ID=""
MFU_IAM_ADMIN_CLIENT_SECRET=""
MFU_IAM_ADMIN_AUDIENCE=""
MFU_IAM_ADMIN_SCOPE=""
MFU_IAM_COMPAT_PROFILE=""
MFU_IAM_ALLOWED_DOMAINS=""
MFU_IAM_DEFAULT_ROLE="analyst"
MFU_IAM_MOCK_ENABLED=false
# Secure template-shell handoff. The template owns school sign-in/2FA; ATDR
# accepts only a short-lived form-posted code and exchanges it server-to-server.
# Keep this disabled until private bridge values are configured in both services.
MFU_IAM_TEMPLATE_SHELL_ENABLED=false
MFU_IAM_TEMPLATE_SHELL_BASE_URL=""
MFU_IAM_TEMPLATE_SHELL_ME_PATH="/api/v1/auth/me"
MFU_IAM_TEMPLATE_SHELL_HEADER="x-access-token"
MFU_IAM_HANDOFF_ENABLED=false
MFU_IAM_HANDOFF_EXCHANGE_PATH="/api/v1/atdr/handoff/exchange"
MFU_IAM_HANDOFF_SHARED_SECRET=""
MFU_IAM_HANDOFF_SECRET_HEADER="x-atdr-handoff-secret"
MFU_IAM_HANDOFF_FRONTEND_URL="http://127.0.0.1:5173"
MFU_IAM_HANDOFF_COOKIE_NAME="atdr_session"
MFU_IAM_HANDOFF_COOKIE_SECURE=false
MFU_IAM_HANDOFF_ALLOWED_ORIGINS=""
MFU_IAM_HANDOFF_ALLOWED_RETURN_PATHS="/overview,/alerts,/logs,/assistant,/response,/audit,/ml"
MFU_IAM_TEMPLATE_SHELL_LAUNCH_URL=""
MFU_IAM_ADMIN_GROUPS=""
# Optional explicit admin mapping for externally authenticated school-email users.
# Keep empty until the lab owner approves which school-email accounts map to admin.
MFU_IAM_ADMIN_EMAILS=""
MFU_IAM_PERMISSION_SOURCE=""
MFU_IAM_PERMISSION_BOOTSTRAP_MODE=""
MFU_IAM_PERMISSION_ROOT_PATH=""
MFU_IAM_PERMISSION_PATHS=""
MFU_IAM_PROJECT_ACCOUNT_EMAIL=""
MFU_IAM_AUTH_REQUIRE_2FA=false
MFU_IAM_AUDIT_RETENTION_DAYS=90
MFU_IAM_MANAGED_CLIENT_ID=""
MFU_IAM_MANAGED_CLIENT_ENDPOINT=""
MFU_IAM_MANAGED_CLIENT_OWNER_EMAIL=""
MFU_IAM_MANAGED_CLIENT_ALLOWED_SCOPES=""
MFU_IAM_MANAGED_CLIENT_ALLOWED_AUDIENCES=""
MFU_IAM_INIT_ADMIN_EMAILS=""
MFU_IAM_INIT_SEED_ADMIN_EMAIL=""
# Compatibility note: ATDR also accepts supervisor template names
# IAM_SDK_*, IAM_ADMIN_*, and PROJECT_PERMISSION_* in a private local `.env`.
# Do not commit real IAM secrets.
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=""

# School-email account policy. Leave optional until the shared lab domain
# policy is approved.
SCHOOL_EMAIL_DOMAINS=""
REQUIRE_SCHOOL_EMAIL=false
LOCAL_EMAIL_LOGIN_ENABLED=true

# Email verification/notification foundation. Disabled by default. For local
# school-email workflow testing, prefer EMAIL_DELIVERY_MODE=dev_outbox so codes
# stay in the admin-only dashboard outbox and no real email is sent.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
EMAIL_DELIVERY_MODE="disabled"
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_REQUIRED_FOR_LOGIN=false
EMAIL_VERIFICATION_REQUIRED_FOR_ADMIN_ACTIONS=false

DASHBOARD_SUMMARY_CACHE_SECONDS=30

# Operational history maintenance. The app never deletes evidence
# automatically; use the maintenance command explicitly after review.
JOB_STALE_AFTER_MINUTES=60
JOB_RETENTION_DAYS=30
RUN_HISTORY_RETENTION_DAYS=90

# Durable operation worker. The API process never starts this worker itself.
# Keep false until a named lab operator intentionally starts --watch.
OPERATION_WORKER_ENABLED=false
OPERATION_WORKER_POLL_SECONDS=1
OPERATION_WORKER_LEASE_SECONDS=900
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_WORKER_DEPLOYMENT_ID=shared-lab
OPERATION_WORKER_CONCURRENCY=2
OPERATION_WORKER_SHUTDOWN_GRACE_SECONDS=120
OPERATION_JOB_DEFAULT_MAX_ATTEMPTS=1
OPERATION_JOB_MAX_ATTEMPTS=3
OPERATION_JOB_RETRY_DELAY_SECONDS=60
OPERATION_JOB_MAX_INPUT_BYTES=52428800
INGESTION_CHUNK_SIZE=500
INGESTION_PROGRESS_UPDATE_INTERVAL=500
OPERATION_MAX_QUEUED_IMPORTS=10
OPERATION_MAX_QUEUED_JOBS_PER_ACTOR=5
OPERATION_STAGING_MAX_TOTAL_BYTES=1073741824
OPERATION_STAGING_MIN_FREE_BYTES=268435456
OPERATION_STAGING_RETENTION_HOURS=24
# Multi-host workers require the same mounted absolute path and storage ID.
OPERATION_STAGING_ROOT="/srv/atdr/shared/operation-jobs"
OPERATION_STAGING_SHARED=true
OPERATION_STAGING_STORAGE_ID=shared-lab-staging-v1
OPERATION_QUEUE_BACKLOG_WARNING=25
OPERATION_JOB_FAILURE_WARNING_COUNT=3
OPERATION_JOB_FAILURE_WARNING_WINDOW_MINUTES=60
# Audit retention never deletes raw logs and defaults to a dry-run report.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_MIN_DAYS=90
AUDIT_RETENTION_BATCH_SIZE=500

# SOC analyst assistant. Keep external LLM disabled until provider, data
# handling, redaction, and school policy are approved.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER="disabled"
ASSISTANT_MODEL=""
ASSISTANT_API_KEY=""
# Future real LLM adapter placeholders. Keep disabled until provider, key
# storage, redaction, and school data-sharing rules are approved.
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=""
ASSISTANT_LLM_MODEL=""
ASSISTANT_LLM_API_KEY=""
ASSISTANT_LLM_BASE_URL=""
ASSISTANT_LLM_TIMEOUT_SECONDS=15
ASSISTANT_LLM_MAX_RETRIES=2
ASSISTANT_LLM_MAX_PROMPT_CHARS=12000
ASSISTANT_CONVERSATION_HISTORY_TURNS=4
ASSISTANT_RATE_LIMIT_REQUESTS=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
ASSISTANT_MAX_CONTEXT_ROWS=20
ASSISTANT_REDACT_IPS=true
ASSISTANT_ALLOW_RAW_LOG_CONTEXT=false

# Real firewall enforcement is not part of this profile.
# Keep RESPONSE_SIMULATION=true until an approved small-office firewall connector,
# allowlist, rollback process, and lab change window exist.
# PostgreSQL is optional for lab deployment. MongoDB is not used by ATDR v0.3.
