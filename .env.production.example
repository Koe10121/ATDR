APP_NAME="MFU ATDR"

# Future hardened deployment profile.
# This is a template only. Do not deploy until reviewed by the project owner,
# supervisor, and network/firewall administrators.
ENVIRONMENT="production"
DATABASE_URL="postgresql+psycopg2://atdr:replace-with-production-password@postgres:5432/atdr"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000
AUTO_CREATE_TABLES=false

# Real firewall blocking is unsupported until a formally approved connector,
# allowlist, rollback plan, and change process exist.
RESPONSE_SIMULATION=true
RESPONSE_PROVIDER="simulation"

DEFAULT_IMPORT_LIMIT=5000
MIN_ALERT_SCORE=30
ML_MODEL_PATH="atdr/models/isolation_forest.joblib"
SUPERVISED_MODEL_PATH="atdr/models/supervised_classifier.joblib"
ML_CONTAMINATION=0.03
API_BASE_URL="https://atdr.example.local/api"

# Required: replace with a long random secret from a secure secret manager.
JWT_SECRET_KEY="replace-with-secure-production-secret-from-secret-manager"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=240

# Do not keep demo credentials in production. Prefer SSO/identity integration
# before real deployment. These placeholders must be replaced or disabled.
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="replace-and-disable-demo-admin"
DEMO_ANALYST_USERNAME="analyst"
DEMO_ANALYST_PASSWORD="replace-and-disable-demo-analyst"
DEMO_SAMPLE_LOG_PATH="data/samples/paloalto-demo.txt"
DEMO_IMPORT_LIMIT=5000

LOG_LEVEL="INFO"
LOG_FORMAT="json"
SERVICE_VERSION="0.1.0"
CORS_ALLOWED_ORIGINS="https://atdr.example.local"
SECURITY_HEADERS_ENABLED=true
# The reference Nginx deployment connects over loopback. Never trust all CIDRs.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"

# Public syslog binding requires host firewall rules and lab network approval.
SYSLOG_ENABLED=false
SYSLOG_HOST="127.0.0.1"
SYSLOG_PORT=5514
SYSLOG_BATCH_SIZE=500

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# External IAM is future work. Keep disabled until a real OIDC provider,
# callback URL, client secret, allowed domains, and role mapping are approved.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER_URL=""
OIDC_ALLOWED_DOMAINS=""
OIDC_DEFAULT_ROLE="analyst"

# Secure MFU template-shell handoff. This production template is intentionally
# disabled until the administrator configures the same dedicated bridge secret
# in the template backend and ATDR's managed secret store. Never use an IAM
# client secret here and never pass template tokens through a browser URL.
MFU_IAM_ENABLED=false
MFU_IAM_ALLOWED_DOMAINS=""
MFU_IAM_DEFAULT_ROLE="analyst"
MFU_IAM_TEMPLATE_SHELL_ENABLED=false
MFU_IAM_TEMPLATE_SHELL_BASE_URL=""
MFU_IAM_HANDOFF_ENABLED=false
MFU_IAM_HANDOFF_EXCHANGE_PATH="/api/v1/atdr/handoff/exchange"
MFU_IAM_HANDOFF_SHARED_SECRET=""
MFU_IAM_HANDOFF_SECRET_HEADER="x-atdr-handoff-secret"
MFU_IAM_HANDOFF_FRONTEND_URL="https://atdr.example.local"
MFU_IAM_HANDOFF_COOKIE_NAME="atdr_session"
MFU_IAM_HANDOFF_COOKIE_SECURE=true
MFU_IAM_HANDOFF_ALLOWED_ORIGINS=""
MFU_IAM_HANDOFF_ALLOWED_RETURN_PATHS="/overview,/alerts,/logs,/assistant,/response,/audit,/ml"
MFU_IAM_TEMPLATE_SHELL_LAUNCH_URL=""
MFU_IAM_ADMIN_GROUPS=""

SCHOOL_EMAIL_DOMAINS=""
REQUIRE_SCHOOL_EMAIL=true
LOCAL_EMAIL_LOGIN_ENABLED=true

SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

DASHBOARD_SUMMARY_CACHE_SECONDS=30

# Durable operation worker is opt-in. This API process must not start it
# automatically. Use a separately managed worker after operational approval.
JOB_STALE_AFTER_MINUTES=60
JOB_RETENTION_DAYS=30
RUN_HISTORY_RETENTION_DAYS=90
OPERATION_WORKER_ENABLED=false
OPERATION_WORKER_POLL_SECONDS=1
OPERATION_WORKER_LEASE_SECONDS=900
OPERATION_WORKER_HEARTBEAT_SECONDS=15
OPERATION_WORKER_DEPLOYMENT_ID=replace-with-deployment-id
OPERATION_WORKER_CONCURRENCY=2
OPERATION_WORKER_SHUTDOWN_GRACE_SECONDS=120
OPERATION_JOB_DEFAULT_MAX_ATTEMPTS=1
OPERATION_JOB_MAX_ATTEMPTS=3
OPERATION_JOB_RETRY_DELAY_SECONDS=60
OPERATION_JOB_MAX_INPUT_BYTES=52428800
INGESTION_CHUNK_SIZE=500
INGESTION_PROGRESS_UPDATE_INTERVAL=500
OPERATION_MAX_QUEUED_IMPORTS=10
OPERATION_MAX_QUEUED_JOBS_PER_ACTOR=5
OPERATION_STAGING_MAX_TOTAL_BYTES=1073741824
OPERATION_STAGING_MIN_FREE_BYTES=268435456
OPERATION_STAGING_RETENTION_HOURS=24
OPERATION_STAGING_ROOT="/srv/atdr/shared/operation-jobs"
OPERATION_STAGING_SHARED=true
OPERATION_STAGING_STORAGE_ID=replace-with-shared-storage-id
OPERATION_QUEUE_BACKLOG_WARNING=25
OPERATION_JOB_FAILURE_WARNING_COUNT=3
OPERATION_JOB_FAILURE_WARNING_WINDOW_MINUTES=60
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_MIN_DAYS=90
AUDIT_RETENTION_BATCH_SIZE=500
